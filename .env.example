# Copy to .env and fill in. Loaded by python-dotenv locally and by Docker Compose.

# Postgres/TimescaleDB DSN. Compose overrides this for the container.
DATABASE_URL=postgresql://transponder:transponder@localhost:5432/transponder

# Path to the feed configuration.
FEEDS_CONFIG=feeds.yaml

# Feed secrets referenced by `auth.env` in feeds.yaml. A variable may hold
# several keys separated by commas; they are rotated when one is exhausted.
TRANSLINK_API_KEYS=

# Alerting (see `alerting:` in feeds.yaml). Leave empty to disable pushes.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# ALERT_WEBHOOK_URL=

# Optional tuning (defaults shown).
# LOG_LEVEL=INFO
# DB_POOL_MIN=1
# DB_POOL_MAX=4
# WRITER_BATCH_ROWS=5000
# WRITER_FLUSH_SECONDS=1.0
# WRITER_QUEUE_SIZE=2000
# RT_DEDUPE_SECONDS=3600   # skip realtime rows identical to one written this recently; 0 disables
